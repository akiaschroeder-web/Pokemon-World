MahoganyTown_EventScript_MerchantTrigger_Hns::
	lock
	turnobject LOCALID_HNS_MAHOGANY_MERCHANT, DIR_SOUTH
	playse SE_PIN
	applymovement LOCALID_HNS_MAHOGANY_MERCHANT, Common_Movement_ExclamationMark
	delay 60
	turnobject OBJ_EVENT_ID_PLAYER, DIR_NORTH
	getplayerxy VAR_TEMP_0, VAR_TEMP_1
	call_if_eq VAR_TEMP_1, 14, MahoganyTown_EventScript_WalkUp2_Hns
	call_if_eq VAR_TEMP_1, 13, MahoganyTown_EventScript_WalkUp1_Hns
	showmoneybox 0, 0
	msgbox MahoganyTown_Text_RageCandyBarMerchantTryOne_Hns, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, FALSE, MahoganyTown_EventScript_MerchantRefused_Hns
	checkmoney 300
	goto_if_eq VAR_RESULT, FALSE, MahoganyTown_EventScript_MerchantBroke_Hns
	removemoney 300
	updatemoneybox
	playse SE_SHOP
	msgbox MahoganyTown_Text_RageCandyBarMerchantSavorIt_Hns, MSGBOX_DEFAULT
	giveitem ITEM_RAGE_CANDY_BAR
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_BagIsFull
	hidemoneybox
	closemessage
	getplayerxy VAR_TEMP_0, VAR_TEMP_1
	call_if_eq VAR_TEMP_0, 30, MahoganyTown_EventScript_PushPlayer_Hns
	release
	end

