OlivineLighthouse_EventScript_JasmineDeliverPotion_Hns::
	msgbox OlivineLighthouse_Text_JasmineCureAmphy_Hns, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, FALSE, OlivineLighthouse_EventScript_JasmineRefuse_Hns
	playse SE_USE_ITEM
	removeitem ITEM_SECRET_POTION
	msgbox OlivineLighthouse_Text_PlayerHandedSecretpotion_Hns, MSGBOX_DEFAULT
	waitse
	msgbox OlivineLighthouse_Text_JasmineDontBeOffended_Hns, MSGBOX_DEFAULT
	closemessage
	turnobject LOCALID_HNS_LIGHTHOUSE_JASMINE, DIR_NORTH
	delay 20
	turnobject LOCALID_HNS_LIGHTHOUSE_AMPHAROS, DIR_SOUTH
	playse MUS_HEAL
	waitse
	msgbox OlivineLighthouse_Text_JasmineAmphyHowFeeling_Hns, MSGBOX_DEFAULT
	fadescreen FADE_TO_WHITE
	playse SE_M_THUNDERBOLT2
	waitse
	fadescreen FADE_FROM_WHITE
	playmoncry SPECIES_AMPHAROS, CRY_MODE_NORMAL
	msgbox OlivineLighthouse_Text_AmphyPaluPalulu_Hns, MSGBOX_DEFAULT
	waitmoncry
	closemessage
	applymovement LOCALID_HNS_LIGHTHOUSE_AMPHAROS, OlivineLighthouse_Movement_Amphy_Hns
	waitmovement 0
	applymovement LOCALID_HNS_LIGHTHOUSE_JASMINE, OlivineLighthouse_Movement_Jasmine_Hns
	msgbox OlivineLighthouse_Text_JasmineThankYou_Hns, MSGBOX_DEFAULT
	closemessage

	fadescreen FADE_TO_BLACK
	playse SE_EXIT
	setflag FLAG_HIDE_LIGHTHOUSE_JASMINE
	removeobject LOCALID_HNS_LIGHTHOUSE_JASMINE
	waitse
	delay 50
	fadescreen FADE_FROM_BLACK
	setvar VAR_SAFARI_ZONE_GATE_STATE, 1
	setvar VAR_OLIVINE_CITY_STATE, 5
	setflag FLAG_AMPHAROS_HEALED
	clearflag FLAG_HIDE_OLIVINE_CITY_GYM_JASMINE
	release
	end

