	applymovement OBJ_EVENT_ID_CAMERA, SaffronStation_Movement_SlideLeft_Hns
	fadescreen FADE_TO_BLACK
	waitse
	special RemoveCameraObject
	setvar VAR_TRAIN, 1
	delay 60
	warp MAP_GOLDENROD_CITY_TRAIN_STATION_HNS, 19, 16
	delay 60
	end

